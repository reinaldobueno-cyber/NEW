{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "new-arena-api",
  "main": "worker/arena-api.js",
  "compatibility_date": "2026-10-08",
  "compatibility_flags": ["nodejs_compat"],
  "r2_buckets": [
    { "binding": "VIDEOS", "bucket_name": "new-arena-videos" }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
